// Firestore rules for Print Hours. Paste into Firebase Console -> Firestore Database -> Rules -> Publish.
// Each user owns users/{uid}/** and nothing else is readable or writable.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
